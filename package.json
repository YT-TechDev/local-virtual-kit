{
  "name": "local-virtual-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:desktop": "pnpm --filter @lvk/desktop dev",
    "dev:web": "pnpm --filter @lvk/web-preview dev",
    "dev:motion-bridge": "node tools/motion-ws-bridge.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:native-diagnostics-summarize && pnpm test:motion-validator-import && pnpm test:motion-ws-bridge && pnpm test:electron-helper-spawn-diagnostic && pnpm test:electron-helper-lifecycle-exit-diagnostic && pnpm test:electron-native-status-accessibility && pnpm test:electron-runtime-settings-persistence && pnpm test:electron-lifecycle-controls && pnpm test:electron-native-runtime-status-contract && pnpm test:electron-native-pipeline-lifecycle-transitions && pnpm test:electron-runtime-status-summary && pnpm test:electron-runtime-message-panel && pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:native-diagnostics-summarize": "node tools/check-native-diagnostics-summarizer.mjs",
    "test:motion-validator-import": "node tools/check-motion-frame-validator-import.mjs",
    "diagnostics:summarize": "node tools/summarize-native-diagnostics.mjs",
    "test:motion-ws-bridge": "node tools/check-motion-ws-bridge.mjs",
    "test:native-tracker-options": "node tools/check-native-tracker-options.mjs",
    "test:synthetic-helper": "node tools/check-synthetic-helper-output.mjs",
    "test:helper-result-mapping": "node tools/check-helper-result-mapping.mjs",
    "test:helper-process-supervision": "node tools/check-helper-process-supervision.mjs",
    "test:helper-runtime-integration": "node tools/check-helper-runtime-integration.mjs",
    "test:helper-runtime-fallback": "node tools/check-helper-runtime-fallback.mjs",
    "test:electron-helper-spawn-diagnostic": "node tools/check-electron-helper-spawn-diagnostic.mjs",
    "test:electron-helper-lifecycle-exit-diagnostic": "node tools/check-electron-helper-lifecycle-exit-diagnostic.mjs",
    "test:electron-native-status-accessibility": "node tools/check-electron-native-status-accessibility.mjs",
    "test:electron-runtime-settings-persistence": "node tools/check-electron-runtime-settings-persistence.mjs",
    "test:electron-lifecycle-controls": "node tools/check-electron-lifecycle-controls.mjs",
    "test:electron-native-runtime-status-contract": "node tools/check-electron-native-runtime-status-contract.mjs",
    "test:electron-native-pipeline-lifecycle-transitions": "node tools/check-electron-native-pipeline-lifecycle-transitions.mjs",
    "test:electron-runtime-status-summary": "node tools/check-electron-runtime-status-summary.mjs",
    "test:electron-runtime-message-panel": "node tools/check-electron-runtime-message-panel.mjs",
    "test:web-preview-native-frame-status": "node tools/check-web-preview-native-frame-status.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
